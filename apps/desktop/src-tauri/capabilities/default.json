{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the Atomic main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:webview:allow-internal-toggle-devtools",
    "os:default",
    "os:allow-platform",
    "os:allow-arch",
    "os:allow-version",
    "process:allow-restart",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "notification:default",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "window-state:default",
    "updater:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "deep-link:default",
    {
      "identifier": "http:default",
      "comment": "One entry per provider in packages/core/src/providers/registry.ts. The HTTP plugin denies everything not listed here, so adding a provider means adding it here too. The two catch-all entries cover URLs the user supplies at runtime, chiefly the Ollama server address, which cannot be enumerated here because it is configurable. Plain HTTP to any host is allowed for that reason; a self-hosted Ollama on a LAN address is plain HTTP by default, and narrowing it to localhost would make the feature work only in the case that needs it least.",
      "allow": [
        { "url": "https://opencode.ai/zen/*" },
        { "url": "https://models.dev/*" },
        { "url": "https://api.openai.com/*" },
        { "url": "https://api.anthropic.com/*" },
        { "url": "https://openrouter.ai/*" },
        { "url": "https://api.groq.com/*" },
        { "url": "https://api.mistral.ai/*" },
        { "url": "https://api.deepseek.com/*" },
        { "url": "https://generativelanguage.googleapis.com/*" },
        { "url": "http://localhost:11434/*" },
        { "url": "http://*:*" },
        { "url": "https://*:*" }
      ]
    }
  ]
}
